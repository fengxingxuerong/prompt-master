# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# 密钥（走环境变量注入，绝不让密钥进 git 历史）
.env
.env.*
!.env.example
*.key
*.pem

# 运行产物（状态存档 / 报告 / 缓存 / 检查点）
logs/
*.log
# watchdog 的"这条我已经提醒过"标记：纯运行态，入库会让 git status 长期脏
releases/suite/.stale_notified.json
# watchdog 告警台账同理：append-only 运行态（2026-09-26 出索引）
releases/suite/watchdog_log.jsonl
# 本地手工备份目录：历史版本 git 里都有，双轨拷贝只制造噪音（2026-09-26 出索引）
backups/
# 跨进程写锁句柄（pm/modelhub 的 JSON 台账用）：运行态，不属于配置
*.lock

# ModelHub 运行态台账（2026-09-28 出索引）：usage_daily 每次 API 调用都写（跟踪它 =
# git status 常脏），vkeys/agents 是热载注册表（缺失自动从空重建，见 usage_store._load /
# vkeys._reload）。损坏留存件 .corrupt-* 是本地排查现场，不进历史
data/usage_daily.json
data/usage_daily.json.corrupt-*
data/vkeys.json
data/agents.json

# 一次性终端输出别再落回仓库根（历史证据已归档到 releases/archive/coverage-notes-20260925/）
/.cov*.txt
/pytest_summary.txt

# 覆盖率产物
.coverage
coverage.xml
coverage.json
cov.json
htmlcov/

# 验收 / e2e 脚本跑出来的临时报告（不属于源码，但 .sh/.ps1 脚本本身要入库）
e2e_report*.md
e2e_*_report.md
examples/sample_report.md
.pytest_cache*

# IDE / 系统
.idea/
.vscode/
.trae/
# 本机会话目录（智能体会话产物，同 .trae/ 先例，不该进版本库）
.box-agent/
.DS_Store
Thumbs.db

# 一次性诊断输出（同 /.cov*.txt 先例）
/mcp_cov.txt

# 打包产物
*.egg-info/
build/
dist/

# SQLite 运行库（M3.4 起三服务存储真值源，快照 JSON 仍跟踪）
*.db
*.db-wal
*.db-shm

# 会话工作/暂存目录（同 .box-agent/ 先例：智能体会话产物，不该进版本库）
.box-agent-scratch/
# 工件指针标记（会话工具给产物打的 22 字节 JSON，2026-10-11 出索引）
*.artifact.json

# 宣传片（AI 视频制作器产物：成片 + Remotion 工程动辄数 GB）
宣传片/
# box-agent 会话工作区（demo HTML + QA 截图等会话产物，同 .box-agent/ 先例，不该进版本库）
小浣熊/

# 会话工具产物（box-agent/工作区指针那一族，2026-10-14 又长出一个）：
# 与 62c55e1 / 8f68324 同判据 —— 不是主题文件，别让它把 git status 弄成长草
.workbuddy/
