# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# 密钥（走环境变量注入，绝不让密钥进 git 历史）
.env
.env.*
!.env.example
*.key
*.pem

# 运行产物（状态存档 / 报告 / 缓存 / 检查点）
logs/
*.log
# watchdog 的"这条我已经提醒过"标记：纯运行态，入库会让 git status 长期脏
releases/suite/.stale_notified.json
# watchdog 告警台账同理：append-only 运行态（2026-09-26 出索引）
releases/suite/watchdog_log.jsonl
# 本地手工备份目录：历史版本 git 里都有，双轨拷贝只制造噪音（2026-09-26 出索引）
backups/
# 跨进程写锁句柄（pm/modelhub 的 JSON 台账用）：运行态，不属于配置
*.lock

# ModelHub 运行态台账（2026-09-28 出索引）：usage_daily 每次 API 调用都写（跟踪它 =
# git status 常脏），vkeys/agents 是热载注册表（缺失自动从空重建，见 usage_store._load /
# vkeys._reload）。损坏留存件 .corrupt-* 是本地排查现场，不进历史
data/usage_daily.json
data/usage_daily.json.corrupt-*
data/vkeys.json
data/agents.json

# 一次性终端输出别再落回仓库根（历史证据已归档到 releases/archive/coverage-notes-20260925/）
/.cov*.txt
/pytest_summary.txt

# 覆盖率产物
.coverage
coverage.xml
coverage.json
cov.json
htmlcov/

# 验收 / e2e 脚本跑出来的临时报告（不属于源码，但 .sh/.ps1 脚本本身要入库）
e2e_report*.md
e2e_*_report.md
examples/sample_report.md
.pytest_cache*

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 打包产物
*.egg-info/
build/
dist/

# SQLite 运行库（M3.4 起三服务存储真值源，快照 JSON 仍跟踪）
*.db
*.db-wal
*.db-shm
