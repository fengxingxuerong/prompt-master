# ============================================================
# PromptMaster 配置示例：复制为 .env 后填写
# ============================================================

# ---- 全局默认（所有角色共用）----
# openai = 任意 OpenAI 兼容端点（含 DeepSeek / 通义 / SenseNova / 本地 vLLM 等）
# anthropic = Claude 官方接口
PM_PROVIDER=openai
PM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 多 Key 轮换（可选）：逗号分隔。单 Key 撞 429（rpm/tpm exhausted）时自动切下一个，
# 避免整条流水线被一个 Key 的配额卡死。
# ⚠️ 角色级 PM_<角色>_API_KEY 一旦设置，该角色的池就只有它自己（不并入全局池）——
#    因为跨端点混 Key 会让 429 退避拿别的厂商的 Key 打过来，直接 401。
# PM_API_KEYS=sk-aaaaaaaa,sk-bbbbbbbb,sk-cccccccc
PM_BASE_URL=https://api.openai.com/v1
PM_MODEL=gpt-4o-mini
PM_TIMEOUT=120
# 一次调用的墙钟预算（含全部通道、全部重试、全部退避）。0 = 不设上限（旧行为）。
# 为什么需要它：`PM_TIMEOUT` 只管**单发**请求，而重试是叠层的——叠满最坏是
# (1+SDK 重试)×(1+连接重试)×PM_TIMEOUT，再乘通道 B 的解析重试次数。2026-10-02 真端点
# 轮里那段 15 分钟日志空洞就是这么来的（单次调用最坏挂到几十分钟）。
# 默认 600s 来自实测分布：历史 trace 中 >60s 的单调用最慢 122.2s，600s 容得下 3~4 次
# 正常尝试，只砍"每发都吃满 timeout 再叠三层"的病态形态。
# PM_CALL_BUDGET=600
# openai/anthropic SDK 的**隐式**重试次数。缺省钉成 0：那层重试不看代码想不到、日志不留痕，
# 而且不受上面这条预算管辖。我方已有两处可见重试（连接故障短退避 `PM_CONN_RETRIES`、
# 429 退避+换 Key `PM_RATE_LIMIT_RETRIES`），它们才在预算管辖内。确需恢复时设 >0。
# PM_SDK_RETRIES=0

# ---- 分角色覆盖（推荐：强模型做优化，便宜模型做澄清/评估）----
# 两套常用档位（LLM 分配评审追记）：
#   省钱档：PM_MODEL=轻量模型（clarifier/mockgen/evaluator 全走它）
#           PM_OPTIMIZER_MODEL=旗舰  PM_REVISER_MODEL=旗舰   # 只有生成角色吃能力
#           PM_JUDGES=1                                            # 单评委，分歧靠仲裁兜底
#   质量档：PM_JUDGES=2 且评委 A/B 用不同模型家族（如 A=DeepSeek、B=GLM）
# 评估调用是成本大头（每轮 = 用例数 × 评委数），预算敏感先动这两处。
# 优化器：决定提示词质量上限，建议用最强模型
PM_OPTIMIZER_MODEL=gpt-4o
PM_OPTIMIZER_TEMPERATURE=0.4

# 评估器：要求客观，温度压到最低
PM_EVALUATOR_MODEL=gpt-4o-mini
PM_EVALUATOR_TEMPERATURE=0.1
# ⚠️ 评委的 max_tokens 不是小事：思考型模型把 reasoning 计入预算，吃满就返回**空正文**，
# 结构化解析拿不到 JSON → 该锚点被校准丢弃 / 该次评估被记为失败（症状是"重试 3 次仍失败"）。
# 代码默认 evaluator=8000（实测 6000 时 33% 额度耗尽、8000 时 0%）。
# 用判定式协议（PM_SCORING_MODE=checklist）时 prompt 多一段清单块，reasoning 随 prompt
# 长度 ×1.1~1.5 增长（见 pm/llm.py 的 MAX_TOKENS 注释），预算要跟着抬：
# PM_EVALUATOR_MAX_TOKENS=24000

# 澄清器
PM_CLARIFIER_MODEL=gpt-4o-mini
PM_CLARIFIER_TEMPERATURE=0.2

# 模拟输入生成：需要多样性，温度调高
PM_MOCKGEN_TEMPERATURE=0.8

# 修订器
PM_REVISER_MODEL=gpt-4o
PM_REVISER_TEMPERATURE=0.3

# ---- 被测目标模型 ----
# 这是"提示词最终要跑在哪个模型上"。优化器会据此调整策略
# （Claude 偏 XML 结构、开源模型要指令更直接等）。
# 可以和上方优化器用同一个模型，也可以指向另一个待测模型。
PM_TARGET_MODEL=gpt-4o-mini
PM_TARGET_TEMPERATURE=0.7
# 0.7 适合创意类任务；数据分析/代码等确定性任务建议调低（如 0.2），
# 否则采样噪声会被评估器的 robustness 维度扣分

# 若被测模型在另一个平台，可单独指定：
# PM_TARGET_API_KEY=sk-yyyy
# PM_TARGET_BASE_URL=https://api.deepseek.com/v1
# PM_TARGET_MODEL=deepseek-chat



# ---- 事实断言（ground-truth，可选）----

# 给用例附上期望输出后，确定性校验对"达标"有一票否决权：

# 事实不符时评委分再高也不判 passed（评委放水会被显式标记）。

# CLI: --cases-file cases.json --assert-mode contains

# API: POST /api/optimize 传 test_cases 字段，模式同 CLI。

# 模式：exact（strip 后全等）/ contains（子串）/ regex / custom:<name>。

#   自定义断言注册：

#   from pm import assertions

#   assertions.register_assertion("no_x", lambda e, o: "x" not in o)



# ---- 双评委评估（防单一 LLM 自评放水）----
# PM_JUDGES=2  # 评委数：2 = 双评委交叉验证（默认），1 = 单评委（省钱档推荐）
# 第二评委建议用与主评委不同的模型家族，交叉验证才有意义
# 若 B 与 A 落到同模型同端点：未显式配 B 温度时会自动 +0.1 去同质化（每进程告警一次），
# 但这只降低采样相关性，换不同模型家族才是根治。
#
# 异源配置三步（质量档推荐）：
#   1. 给 B 换家族：A=DeepSeek 系时 B 用 GLM / Claude / Gemini 系，跨公司相关性最低；
#   2. B 的端点/Key 通常也不同（不同厂商必然不同端点），显式配全三件套；
#   3. 配完先跑 `python run.py --preflight` 确认 evaluator_b 一行是 ✅，
#      再看输出里的模型名确实是两家——预检同时验证配置没被 .env 注回覆盖。
PM_EVALUATOR_B_MODEL=gpt-4o-mini
PM_EVALUATOR_B_TEMPERATURE=0.1
# PM_EVALUATOR_B_API_KEY=sk-yyyy
# PM_EVALUATOR_B_BASE_URL=https://api.deepseek.com/v1

# 分差阈值：双评委加权分差超过该值（默认 2.0）时触发第三评委仲裁
PM_JUDGE_DISAGREEMENT=2.0
# 评委复现性极差：先跑 `python run.py calibrate --judge evaluator_b --repeat 3` 量出来再填
# （同输入重复打分观察到的最大极差）。填了之后 ci_lower 会把它算进不确定度，
# 并把上面的仲裁线抬高到噪声之上；不填（0）完全等于旧行为。
# 本机实测 2026-09-19：评委A 0.25~0.70 / 评委B(glm-5.2) 1.30~2.60 / 仲裁 0.60~4.43
# PM_JUDGE_JITTER=2.6
# 仲裁评委（可选，默认复用主评估器配置）
# PM_ARBITER_MODEL=gpt-4o
# PM_ARBITER_TEMPERATURE=0.0

# ---- 目标模型并发 ----
# 被测用例并发调用数（默认 4，硬上限 32）；调高加快迭代但注意目标 API 速率限制
PM_TARGET_MAX_CONCURRENCY=4

# ---- 本地结果缓存（断点续跑不重算，省 API 预算）----
# PM_EVAL_CACHE=1      # 评估结果缓存开关
# PM_TARGET_CACHE=1    # 目标模型输出缓存开关
# PM_CACHE_DIR=logs    # 缓存目录（默认 logs/）

# ---- 评分口径与运行行为 ----
# 达标阈值：平均分需 >= 该值，且最低分 >= 该值-1，且实际用例数 >= 声明条数
PM_PASS_THRESHOLD=8.0
# 端点不支持原生结构化输出时置 1：跳过通道 A，避免每次先白打一个失败请求
# （不置 1 也行：第一次撞到"does not support"后会记住该端点指纹并自动跳过）
# PM_FORCE_JSON_CHANNEL=1
# 结构化输出方法（A10）：留空 = langchain 默认（json_schema）；
# 端点只认 function calling 时设为 function_calling（本地桩 e2e 场景 3 即用此值）
# PM_STRUCT_METHOD=function_calling

# ---- 评分协议（判定式，实验口径）----
# impression（缺省）= 评委直接给五个 1-10 的维度分，旧行为逐字不变。
# checklist        = 评委只答"这条判据有没有违反"+证据，维度分/总分/封顶由代码算
#                    （把填数权从评委手里拿走一半，压自我极差）。
# ⚠️ 换默认的前提是它在同一批锚点上把自我极差压进 2.0 且不牺牲 MAE —— 判据与实测
#    记录见 docs/evaluation.md 与 logs/judge_calibration_history.json；未达标前别写进生产配置。
#    2026-09-25 实测结论：**两条都不满足**（配对 17 条 MAE 0.58→1.79、bias +1.79，
#    10/17 条总分为同一个 9.35）。低极差来自读数塌成常数，不是判得更稳。
# PM_SCORING_MODE=checklist

# ---- 无 Key 演示（假后端）----
# 设了有效场景名就不再调真实端点：progress（逐批提升直到达标）/ stall（始终不达标，
# 验迭代上限兜底）/ dispute（双评委分差过大，验仲裁）/ unclear（验澄清提问）。
# 名字非法 = 告警后按真实后端执行。演示模式不会污染 logs/*_cache.json，且被记忆检索排除。
# ⚠️ 只验证链路与控制流，**不能**用来证明"优化有效"。
# PM_FAKE_BACKEND=progress

# ---- 智能体接入 ----
# submit/status/report/wait 子命令与 MCP server 打的常驻服务地址
# （长任务必须走 server + wait，同步 CLI 跑 40~80 次调用会占住终端 10~30 分钟）
# PM_SERVER_URL=http://127.0.0.1:8080

# ---- 成本闸与限流 ----
# 任务级调用预算：不设 = 不限。设了则在"下一轮修订预计突破预算"时止损，
# 按 early_stopped 交付当前最佳版本（终态复用既有的，Agent/CLI/API 侧不用改口径）。
# PM_MAX_LLM_CALLS=300

# ---- 金额折算（可选）----
# 配了才在报告里出现「成本折算」段，未配则整段不渲染。
# 本系统**不内置价目表**：模型单价会变，写死的价目表第二天就是错的，而且错得看不出来；
# 所以单价必须由你给，单位随你（一般是美元/百万 token）。
# ⚠️ 输入价与输出价必须**同时**给：只给一半时该角色整条不折算——把缺的那半当 0
#    会得到一个系统性偏低、却看起来完全正常的金额。
# PM_PRICE_INPUT_PER_M=0.5
# PM_PRICE_OUTPUT_PER_M=1.5
# 按角色覆盖（真实配置里 target 与 evaluator 常不是同一个模型，单一均价会得出合理的错数）：
# PM_PRICE_TARGET_INPUT_PER_M=0.3
# PM_PRICE_TARGET_OUTPUT_PER_M=1.2
# PM_PRICE_EVALUATOR_INPUT_PER_M=0.5
# PM_PRICE_EVALUATOR_OUTPUT_PER_M=1.5
# 配了单价后，`run.py --dry-run` 会按「最近一次运行的实测逐角色均价」外推本次金额区间。

# REST 服务滑动窗口限流（每分钟请求数，默认 10；0 = 关闭限流，本地单人开发可关）。
# 非整数或负数会告警并回退默认，不炸启动。
# PM_RATE_LIMIT_PER_MIN=10

# ---- 服务端存储与多进程 ----
# 任务表默认是进程内内存表：`run_server.py --workers 2` 起就会随机 404
# （提交在 A 进程、查询打到 B 进程）。要多 worker 必须先设 PM_TASK_DB 共享一份记录。
# PM_TASK_DB=logs/tasks.db
# 结果缓存后端：json（默认，落 logs/）| sqlite（多进程共享；非法值告警回退 json）
# PM_CACHE_BACKEND=sqlite
# 停机排空等待上限（秒）：不设 = 无限等在跑的任务收尾。设了（如 30）到点不再等，
# 避免一个卡死的 LLM 调用拖住整个服务退出。
# PM_DRAIN_TIMEOUT=30
# 记忆检索：把历史达标提示词作为"结构参考"注入优化器（默认开）。
# 0/false/no/off = 关闭。⚠️ 检索只扫最近 N 个运行记录（PM_MEMORY_SCAN_LIMIT，默认 200），
# 超限时会在日志里告警说明被截断了多少 —— 历史越长，被"静默遗忘"的比例要盯着这条告警看。
# PM_MEMORY_HINT=1
# PM_MEMORY_SCAN_LIMIT=200

# ---- 评委校准排程（真实计费，谨慎开）----
# 设了小时数就起一个后台线程，每 N 小时用锚点集回测一次评委（写
# logs/judge_calibration_history.json，可比对漂移）。不设 = 不排程。
# PM_CALIBRATE_HOURS=12
# 排程回测哪个评委（默认 evaluator）
# PM_CALIBRATE_JUDGE=evaluator_b

# ---- 产物与缓存 ----
# PM_LOG_DIR=logs          # 报告 report_<run_id>.md 与状态 run_<run_id>.json 的输出目录
# PM_MAX_TASKS=200         # 服务内存中保留的任务数上限（超出按插入序淘汰；报告仍可从 logs/ 读回）

# ---- REST 服务安全 ----
# 设了 PM_API_TOKEN 之后，POST /api/optimize 与 /api/race 必须带请求头 X-API-Key: <token>
# 服务默认只监听 127.0.0.1；CORS 默认关闭，确实需要跨源时才列白名单
# PM_API_TOKEN=
# PM_ALLOW_ORIGINS=


# ---- 测量层：基线 / 重复采样 / 成对盲评 ----
# 没有这三样，报告只能给出"最终 8.2 分"，给不出"比不优化好多少"。
# 每条用例重复采样次数：中位数定分、极差当噪声（1 = 回到旧口径，快但结论不稳）
PM_SAMPLES_PER_CASE=2
# 基线：把原始需求原样喂给 target，同口径采样与评分，用于算 Δ（约 +40% 调用量）
PM_BASELINE=1
# 成对盲评：优化版 vs 基线，A/B 随机映射让评委选边（每用例 1 次调用）
PM_PAIRWISE=1
# 同用例采样分差超过该值 → 报告点名"结论不稳"
PM_UNSTABLE_SPREAD=1.5
# 评委自报分比代码加权分高过该值 → 判定为系统性放水并告警
PM_JUDGE_BIAS_ALERT=1.0

# 限流退避的总时长上限（单个调用点）：超预算就停止重试并上抛，避免"退避×降级重试"相乘卡死
PM_RATE_LIMIT_MAX_WAIT=60

# ---- 事实断言（ground-truth）行为 ----
# contains 是否忽略大小写 / 全半角(NFKC) / 空白差异；0 = 严格字面匹配
PM_ASSERT_NORMALIZE=1
# 有回溯风险的正则（量词包住分组）会在子进程里跑；超过此秒数直接杀掉并按未通过处理
PM_ASSERT_REGEX_TIMEOUT=2

# 早停判定的兜底余量：PM_SAMPLES_PER_CASE=1 时噪声不可估，用这个余量而不是 0.2，且不判平台期
PM_UNESTIMATED_MARGIN=0.5

# ---- 语义断言（rule 模式）----
# --assert-mode rule 时，expected 作为核对清单注入评估器逐条核验（不做字面比对）。
# 默认只提醒不否决；设 1 则"规则未满足"也像确定性断言一样一票否决。
PM_RULE_VETO=0

# ---- ModelHub: unified model-pool gateway (added 2026-09-21) ----
# config/modelhub.json 引用下面 5 个名字作各端点凭证（密钥不进 git，只留占位符）。
# ⚠️ 少填任意一个：网关启动即 ConfigError（占位符解析不到就报错，不会静默降级），
#    所以哪怕某个上游暂时不用，也要留个值或改 config/modelhub.json 摘掉对应模型。
PM_API_KEY_1=your-sensenova-key-here
PM_API_KEY_AMD=your-amd-radeon-key-here
PM_API_KEY_NVIDIA=your-nvidia-key-here
PM_API_KEY_OPENROUTER=your-openrouter-key-here
PM_API_KEY_STEP=your-stepfun-key-here
# Gateway tuning
PMH_TIMEOUT=90
PMH_BREAK_THRESHOLD=3
PMH_COOLDOWN_SECONDS=300
# Set to require X-API-Key / Bearer auth on the gateway
# PMH_GATEWAY_TOKEN=change-me

# 会审台（releases/triage, :8793）：设了 TRIAGE_TOKEN 后，除 /api/health 与页面（/、/static/*）
# GET 外均需 X-API-Key: <token>。数据读接口（/api/sessions* 等）同样受保护——工单正文含
# 客户内容（M3.1 安全收口 2026-09-23，比 taskboard/lobster 的写接口保护更收紧一档）。
# TRIAGE_TOKEN=change-me

# 任务台账（releases/taskboard, :8792）/ 龙虾站（releases/lobster, :8791）：设了对应 TOKEN 后
# 写接口需 X-API-Key: <token>（/api/health 与页面 GET 豁免）。看门狗会把本文件的
# KEY=VALUE 透传给拉起的服务进程（M3.3），schtasks 环境下同样生效。
# TASKBOARD_TOKEN=change-me
# LOBSTER_TOKEN=change-me
