# ============================================================
# PromptMaster 配置示例：复制为 .env 后填写
# ============================================================

# ---- 全局默认（所有角色共用）----
# openai = 任意 OpenAI 兼容端点（含 DeepSeek / 通义 / SenseNova / 本地 vLLM 等）
# anthropic = Claude 官方接口
PM_PROVIDER=openai
PM_API_KEY=sk-xxxxxxxxxxxxxxxx
PM_BASE_URL=https://api.openai.com/v1
PM_MODEL=gpt-4o-mini
PM_TIMEOUT=120

# ---- 分角色覆盖（推荐：强模型做优化，便宜模型做澄清/评估）----
# 两套常用档位（LLM 分配评审追记）：
#   省钱档：PM_MODEL=轻量模型（clarifier/mockgen/evaluator 全走它）
#           PM_OPTIMIZER_MODEL=旗舰  PM_REVISER_MODEL=旗舰   # 只有生成角色吃能力
#           PM_JUDGES=1                                            # 单评委，分歧靠仲裁兜底
#   质量档：PM_JUDGES=2 且评委 A/B 用不同模型家族（如 A=DeepSeek、B=GLM）
# 评估调用是成本大头（每轮 = 用例数 × 评委数），预算敏感先动这两处。
# 优化器：决定提示词质量上限，建议用最强模型
PM_OPTIMIZER_MODEL=gpt-4o
PM_OPTIMIZER_TEMPERATURE=0.4

# 评估器：要求客观，温度压到最低
PM_EVALUATOR_MODEL=gpt-4o-mini
PM_EVALUATOR_TEMPERATURE=0.1

# 澄清器
PM_CLARIFIER_MODEL=gpt-4o-mini
PM_CLARIFIER_TEMPERATURE=0.2

# 模拟输入生成：需要多样性，温度调高
PM_MOCKGEN_TEMPERATURE=0.8

# 修订器
PM_REVISER_MODEL=gpt-4o
PM_REVISER_TEMPERATURE=0.3

# ---- 被测目标模型 ----
# 这是"提示词最终要跑在哪个模型上"。优化器会据此调整策略
# （Claude 偏 XML 结构、开源模型要指令更直接等）。
# 可以和上方优化器用同一个模型，也可以指向另一个待测模型。
PM_TARGET_MODEL=gpt-4o-mini
PM_TARGET_TEMPERATURE=0.7
# 0.7 适合创意类任务；数据分析/代码等确定性任务建议调低（如 0.2），
# 否则采样噪声会被评估器的 robustness 维度扣分

# 若被测模型在另一个平台，可单独指定：
# PM_TARGET_API_KEY=sk-yyyy
# PM_TARGET_BASE_URL=https://api.deepseek.com/v1
# PM_TARGET_MODEL=deepseek-chat

# ---- 事实断言（ground-truth，可选）----
# 给用例附上期望输出后，确定性校验对"达标"有一票否决权：
# 事实不符时评委分再高也不判 passed（评委放水会被显式标记）。
# CLI: --cases-file cases.json --assert-mode contains
# API: POST /api/optimize 传 test_cases 字段，模式同 CLI。
# 模式：exact（strip 后全等）/ contains（子串）/ regex / custom:<name>。
#   自定义断言注册：
#   from pm import assertions
#   assertions.register_assertion("no_x", lambda e, o: "x" not in o)


# ---- 双评委评估（防单一 LLM 自评放水）----
# PM_JUDGES=2  # 评委数：2 = 双评委交叉验证（默认），1 = 单评委（省钱档推荐）
# 第二评委建议用与主评委不同的模型家族，交叉验证才有意义
# 若 B 与 A 落到同模型同端点：未显式配 B 温度时会自动 +0.1 去同质化（每进程告警一次），
# 但这只降低采样相关性，换不同模型家族才是根治。
PM_EVALUATOR_B_MODEL=gpt-4o-mini
PM_EVALUATOR_B_TEMPERATURE=0.1
# PM_EVALUATOR_B_API_KEY=sk-yyyy
# PM_EVALUATOR_B_BASE_URL=https://api.deepseek.com/v1

# 分差阈值：双评委加权分差超过该值（默认 2.0）时触发第三评委仲裁
PM_JUDGE_DISAGREEMENT=2.0
# 仲裁评委（可选，默认复用主评估器配置）
# PM_ARBITER_MODEL=gpt-4o
# PM_ARBITER_TEMPERATURE=0.0

# ---- 目标模型并发 ----
# 被测用例并发调用数（默认 4，硬上限 32）；调高加快迭代但注意目标 API 速率限制
PM_TARGET_MAX_CONCURRENCY=4

# ---- 本地结果缓存（断点续跑不重算，省 API 预算）----
# PM_EVAL_CACHE=1      # 评估结果缓存开关
# PM_TARGET_CACHE=1    # 目标模型输出缓存开关
# PM_CACHE_DIR=logs    # 缓存目录（默认 logs/）

# ---- 评分口径与运行行为 ----
# 达标阈值：平均分需 >= 该值，且最低分 >= 该值-1，且实际用例数 >= 声明条数
PM_PASS_THRESHOLD=8.0
# 端点不支持原生结构化输出时置 1：跳过通道 A，避免每次先白打一个失败请求
# （不置 1 也行：第一次撞到"does not support"后会记住该端点指纹并自动跳过）
# PM_FORCE_JSON_CHANNEL=1
# 结构化输出方法（A10）：留空 = langchain 默认（json_schema）；
# 端点只认 function calling 时设为 function_calling（本地桩 e2e 场景 3 即用此值）
# PM_STRUCT_METHOD=function_calling

# ---- 产物与缓存 ----
# PM_LOG_DIR=logs          # 报告 report_<run_id>.md 与状态 run_<run_id>.json 的输出目录
# PM_MAX_TASKS=200         # 服务内存中保留的任务数上限（超出按插入序淘汰；报告仍可从 logs/ 读回）

# ---- REST 服务安全 ----
# 设了 PM_API_TOKEN 之后，POST /api/optimize 与 /api/race 必须带请求头 X-API-Key: <token>
# 服务默认只监听 127.0.0.1；CORS 默认关闭，确实需要跨源时才列白名单
# PM_API_TOKEN=
# PM_ALLOW_ORIGINS=


# ---- 测量层：基线 / 重复采样 / 成对盲评 ----
# 没有这三样，报告只能给出"最终 8.2 分"，给不出"比不优化好多少"。
# 每条用例重复采样次数：中位数定分、极差当噪声（1 = 回到旧口径，快但结论不稳）
PM_SAMPLES_PER_CASE=2
# 基线：把原始需求原样喂给 target，同口径采样与评分，用于算 Δ（约 +40% 调用量）
PM_BASELINE=1
# 成对盲评：优化版 vs 基线，A/B 随机映射让评委选边（每用例 1 次调用）
PM_PAIRWISE=1
# 同用例采样分差超过该值 → 报告点名"结论不稳"
PM_UNSTABLE_SPREAD=1.5
# 评委自报分比代码加权分高过该值 → 判定为系统性放水并告警
PM_JUDGE_BIAS_ALERT=1.0

# 限流退避的总时长上限（单个调用点）：超预算就停止重试并上抛，避免"退避×降级重试"相乘卡死
PM_RATE_LIMIT_MAX_WAIT=60

# ---- 事实断言（ground-truth）行为 ----
# contains 是否忽略大小写 / 全半角(NFKC) / 空白差异；0 = 严格字面匹配
PM_ASSERT_NORMALIZE=1
# 有回溯风险的正则（量词包住宿分组）会在子进程里跑；超过此秒数直接杀掉并按未通过处理
PM_ASSERT_REGEX_TIMEOUT=2
